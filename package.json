{
  "name": "room-check",
  "version": "3.0.0",
  "description": "A tunnel-ready presenter assistant with projector slides, phone control and audience interactions.",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "dev:isolated": "DATA_DIR=/tmp/room-check-dev PORT=3100 node --watch --env-file-if-exists=.env server.mjs",
    "share": "node --env-file-if-exists=.env scripts/share.mjs",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.mjs",
    "backup-data": "node --env-file-if-exists=.env scripts/backup-data.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "version:check": "node scripts/version-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check": "for f in server.mjs scripts/*.mjs tests/*.mjs public/*.js; do node --check \"$f\" || exit 1; done",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node tests/unit.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "keywords": [
    "poll",
    "presentation",
    "slides",
    "qr",
    "tunnel"
  ],
  "author": "Muhammad Rashid K",
  "license": "MIT",
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^5.3.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
