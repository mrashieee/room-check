# Optional. Defaults to 3000.
PORT=3000

# Optional. Bind address. Defaults to 0.0.0.0.
# BIND_ADDRESS=0.0.0.0

# Optional. The public URL used for the audience QR code.
# Set this when running behind a domain or reverse proxy.
# PUBLIC_URL=https://poll.example.com

# Optional. Override the data directory. Defaults to ./.data.
# DATA_DIR=./.data

# Optional. If omitted, a session secret is generated and saved in DATA_DIR.
# SESSION_SECRET=replace-with-a-long-random-string
