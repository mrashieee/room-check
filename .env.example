# Optional. Defaults to 3000. Must be a number between 1 and 65535.
PORT=3000

# Optional. Bind address. Defaults to 0.0.0.0, which exposes the app to
# the local network. Use 127.0.0.1 to lock first-run setup to this machine.
# BIND_ADDRESS=0.0.0.0

# Optional. Proxy trust for X-Forwarded-For/Proto. Defaults to loopback.
# Set to 127.0.0.1 or a subnet when running behind a local reverse proxy.
# TRUST_PROXY=loopback

# Optional. The public URL used for the audience QR code.
# Set this when running behind a domain or reverse proxy.
# PUBLIC_URL=https://poll.example.com

# Optional. Override the data directory. Defaults to ./.data.
# DATA_DIR=./.data

# Optional. If omitted, a session secret is generated and saved in DATA_DIR.
# SESSION_SECRET=replace-with-a-long-random-string

# Optional. Set to off to disable the GitHub release check.
# UPDATE_CHECK=on

# Optional. GitHub repository used by the update checker.
# UPDATE_REPO=mrashieee/room-check

# Optional. Override the release API URL for a mirror or local test.
# UPDATE_API_URL=https://api.github.com/repos/mrashieee/room-check/releases/latest

# Optional. Delete presentation files that are not active after this many days.
# PRESENTATION_RETENTION_DAYS=7

# Optional. Keep only the newest N backups when running npm run backup-data.
# BACKUP_KEEP=10
